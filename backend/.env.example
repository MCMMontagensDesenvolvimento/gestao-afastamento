NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Execução nativa: use a senha e a porta do PostgreSQL local, com encoding de URL.
# Docker Compose usa .env da raiz e configura DATABASE_URL com host db.
DATABASE_URL=postgresql://gestao_afastados:SUBSTITUA_SENHA_LOCAL@localhost:5432/gestao_afastados?schema=public

SESSION_COOKIE_NAME=mcm_afastados_session
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_TOUCH_INTERVAL_SECONDS=300
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_IDS=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
MICROSOFT_ALLOWED_EMAIL_DOMAINS=mcm.eng.br,mcmmontagens.com.br

BOOTSTRAP_ADMIN_EMAIL=

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
# S3 permanece reservado: o adapter implementado nesta base é local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

MAX_UPLOAD_BYTES=10485760

# Integracao opcional com o ApData.
# Preencher as tres variaveis ou manter todas vazias.
APDATA_BASE_URL=
APDATA_CLIENT_ID=
APDATA_CLIENT_SECRET=
