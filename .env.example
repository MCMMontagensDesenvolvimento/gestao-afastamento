COMPOSE_PROJECT_NAME=gestao-afastados
TZ=America/Recife

# Valores opcionais para o Compose de desenvolvimento.
POSTGRES_DB=gestao_afastados
POSTGRES_USER=gestao_afastados
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BOOTSTRAP_ADMIN_EMAIL=

# Secret aleatório local (mínimo recomendado 32 caracteres); obrigatório para login.
SESSION_SECRET=

# Microsoft é opcional no desenvolvimento; preencher o conjunto com valores reais.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_IDS=

# Produção utiliza PostgreSQL externo e schema dedicado pela DATABASE_URL.
# Produção não utiliza a senha local de desenvolvimento quando o campo está vazio.
DATABASE_URL=
FRONTEND_ORIGIN=
MICROSOFT_REDIRECT_URI=

STORAGE_DRIVER=local

# Integracao opcional com o ApData.
# Preencher as tres variaveis ou manter todas vazias.
APDATA_BASE_URL=
APDATA_CLIENT_ID=
APDATA_CLIENT_SECRET=


# Producao: migrations executadas automaticamente no startup.
# Habilitar seed somente quando necessario.
# Desabilitar apos a execucao desejada.
RUN_SEED_ON_DEPLOY=false

# Azure Blob Storage.
# Producao utiliza Azure; desenvolvimento utiliza storage local.
# Nunca registrar credenciais reais no repositorio.
AZURE_STORAGE_NAME=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=gestao-afastamento
