COMPOSE_PROJECT_NAME=gestao-afastados
TZ=America/Recife

# Valores opcionais para o Compose de desenvolvimento.
POSTGRES_DB=gestao_afastados
POSTGRES_USER=gestao_afastados
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BOOTSTRAP_ADMIN_EMAIL=

# Produção exige valores reais; não há defaults para os segredos abaixo.
# DATABASE_URL deve usar db:5432 na rede do Compose.
DATABASE_URL=
SESSION_SECRET=
FRONTEND_ORIGIN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_IDS=
MICROSOFT_REDIRECT_URI=

# Definir somente após aprovar o armazenamento do ambiente de produção.
STORAGE_DRIVER=
